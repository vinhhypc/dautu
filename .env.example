# Domain chính thức của site, dùng cho canonical URL, sitemap, Open Graph.
# Biến NEXT_PUBLIC_* được nhúng lúc BUILD: phải đặt trước `pnpm build`, đặt lúc `next start` không có tác dụng.
NEXT_PUBLIC_SITE_URL=https://dautu.vndirect.com.vn

# Origin WordPress mà server Next gọi REST API/HTML. Mặc định domain public; có thể trỏ mạng nội bộ (bỏ qua Cloudflare).
# WP_ORIGIN=https://dautu.vndirect.com.vn

# Địa chỉ WordPress tự nhận (Settings → Site Address), ví dụ domain CMS sau khi WordPress rời domain chính.
# Dùng cho URL ảnh/file và để nhận ra link nội bộ trong nội dung. Mặc định bằng WP_ORIGIN; chỉ cần đặt khi WP_ORIGIN là địa chỉ nội bộ.
# Hai biến WP_* và NEXT_PUBLIC_SITE_URL cũng được đọc lúc BUILD (next.config.ts: ảnh được phép tối ưu, proxy /wp-content/uploads/).
# WP_SITE_ORIGIN=https://cms-dautu.vndirect.com.vn

# Staging / bản xem trước: đặt 1 để chặn công cụ tìm kiếm (robots.txt Disallow: / và header X-Robots-Tag). Production bỏ trống. Đọc lúc BUILD.
# NEXT_PUBLIC_SITE_NOINDEX=1

# Nếu Cloudflare chặn IP server Next (Vercel, cloud…): tạo rule WAF "Skip" khi có header bí mật rồi đặt 2 biến:
# WP_BYPASS_HEADER_NAME=x-dautu-next-key
# WP_BYPASS_HEADER_VALUE=<chuỗi ngẫu nhiên dài, chỉ lưu trong biến môi trường>
